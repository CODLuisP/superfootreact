# ─────────────────────────────────────────────────────────────
# Variables del SERVIDOR (BFF). Copia este archivo a ".env".
# Estas credenciales las lee server.js del lado del servidor: NUNCA
# se incrustan en el navegador (por eso NO llevan prefijo VITE_).
# ─────────────────────────────────────────────────────────────

# Puerto del servidor BFF (Express). El frontend Vite corre en 3000 y
# hace proxy de /api a este puerto.
PORT=8787

# Backend de catálogo (superfood)
CATALOGO_API_URL=http://localhost:4000
CATALOGO_API_KEY=cambia-esta-clave-publica
CATALOGO_ADMIN_KEY=cambia-esta-clave-admin

# Cloudflare Images (para subir/borrar imágenes)
CLOUDFLARE_ACCOUNT_ID=tu-account-id
CLOUDFLARE_API_TOKEN=tu-api-token

# Sesión y admin inicial
SESSION_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
ADMIN_USER=admin
ADMIN_PASSWORD=cambia-esta-contrasena
